<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; min-width: 400px;">
        <ui:VisualElement name="VegetationProfileList" style="flex-grow: 1;">
            <ui:ListView name="VegetationProfileListLV" class="mt-veg-list" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button text="Button" display-tooltip-when-elided="true" name="CreateCreateButton" class="mt-buttonG" style="min-width: 400px;" />
    <ui:VisualElement class="mt-frame" style="min-width: 400px;">
        <ui:VisualElement style="flex-direction: column; margin-left: 0; margin-right: 0; margin-top: 6px; margin-bottom: 6px;" />
        <ui:VisualElement name="PrefabRange">
            <uie:ObjectField label="CurrentPrefab" name="SelectPrefab" />
            <ui:Slider label="权重" value="0.5" high-value="1" name="Weigth" show-input-field="true" />
            <ui:Slider label="基础密度" value="1" high-value="10" name="BaseDensity" show-input-field="true" />
            <uie:FloatField label="最小半径 (m)" name="MinRadius" />
            <ui:MinMaxSlider label="缩放范围" min-value="0.5" max-value="5" low-limit="0" high-limit="2" name="SceleRange" />
            <ui:MinMaxSlider label="Y旋转范围" min-value="0" max-value="360" low-limit="0" high-limit="360" name="YrotationRange" />
            <ui:MinMaxSlider label="高度范围" min-value="1" max-value="12" low-limit="-10" high-limit="10" name="HeigthRange" />
            <ui:MinMaxSlider label="坡度范围" min-value="10" max-value="90" low-limit="-10" high-limit="20" name="SlopeRange" />
            <uie:FloatField label="Edge Slope Threshold" name="EdgeSlopeThreshold" />
            <ui:MinMaxSlider label="Embed Depth Range" min-value="0" max-value="1" low-limit="0" high-limit="1" name="EmbedDepthRange" />
            <uie:FloatField label="Facade Enter Slope" name="FacadeEnterSlope" />
            <uie:FloatField label="Facade Exit Slope" name="FacadeExitSlope" />
            <uie:FloatField label="Facade Min Spacing (m)" name="FacadeMinSpacing" />
            <uie:FloatField label="Probe Step (m)" name="ProbeStep" />
            <uie:FloatField label="Probe Max Dist (m)" name="ProbeMaxDist" />
            <uie:FloatField label="Facade Reference Height (m)" name="FacadeRefHeight" />
            <uie:Vector3Field label="Facade Scale Offset (X/Y/Z)" name="FacadeScaleOffset" />
            <uie:Vector3Field label="Facade Offsets (X/Y/Z)" name="FacadeOffsets" />
            <uie:EnumField label="Facade Smooth Mode" name="FacadeSmoothMode" />
            <uie:IntegerField label="Facade Smooth Window" name="FacadeSmoothWindow" />
            <uie:FloatField label="Facade Smooth Sigma" name="FacadeSmoothSigma" />
            <uie:FloatField label="Facade RDP Epsilon (m)" name="RdpEpsilon" />
            <uie:ColorField label="Preview Bottom Color" name="PreviewBottomColor" />
            <uie:ColorField label="Preview Top Color" name="PreviewTopColor" />
            <ui:Toggle label="Toggle" name="UseContourDetection" />
            <uie:FloatField label="Contour Slope Deg" name="ContourSlopeDeg" />
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: 6px;">
                <ui:Button text="Scan Selected Terrain" name="ScanFacadesButton" style="flex-grow: 1; margin-right: 4px;" />
                <ui:Button text="Bake Facades" name="BakeFacadesButton" style="flex-grow: 1; margin-left: 4px;" />
            </ui:VisualElement>
            <ui:Button text="Apply Min Radius to Selected" name="BatchMinRadiusButton" style="margin-top: 6px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
