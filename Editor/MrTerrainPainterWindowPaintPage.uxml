<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/MrTerrainPainter/Editor/MrTerrainPainterStyles.uss?fileID=7433441132597879392&amp;guid=1094a64c2bc4b654486d9ae7dcc8907c&amp;type=3#MrTerrainPainterStyles" />
    <ui:VisualElement name="PaintParameter" style="flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 1; min-width: auto; min-height: 30px; max-height: 30px; flex-direction: row; justify-content: space-between; align-items: center; margin-left: 3px; margin-bottom: 1px;">
            <ui:Label text="Brush Settings" display-tooltip-when-elided="true" name="BrushSettings" style="font-size: 16px; -unity-text-align: middle-left; margin-left: 0; -unity-font-style: bold; color: rgb(226, 131, 72); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;" />
        </ui:VisualElement>
        <ui:VisualElement style="margin-top: 2px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <uie:EnumField label="笔刷形状" value="Center" name="Shape" style="flex-grow: 1; flex-shrink: 1; max-height: 20px; min-height: 20px; -unity-font-style: normal;" />
                <ui:Toggle name="Preview" style="max-height: 20px; min-height: 20px;" />
            </ui:VisualElement>
            <ui:SliderInt picking-mode="Ignore" label="笔刷大小" value="42" high-value="100" name="Size" style="flex-shrink: 1; flex-grow: 1; max-height: 20px; min-height: 20px;" />
            <ui:SliderInt picking-mode="Ignore" label="绘制强度" value="42" high-value="100" name="Strength" style="flex-shrink: 1; flex-grow: 1; max-height: 20px; min-height: 20px;" />
            <ui:SliderInt picking-mode="Ignore" label="绘制密度" value="42" high-value="100" name="Density" style="flex-shrink: 1; flex-grow: 1; max-height: 20px; min-height: 20px;" />
            <ui:SliderInt picking-mode="Ignore" label="笔刷硬度" value="42" high-value="100" name="Hardness" style="flex-shrink: 1; flex-grow: 1; min-height: 20px; max-height: 20px;" />
            <uie:EnumField label="分布类型" name="Distribution" style="flex-shrink: 1; flex-grow: 1; max-height: 20px; min-height: 20px;" />
            <uie:CurveField label="边缘曲线" name="FalloffCurve" style="flex-shrink: 1; flex-grow: 1;" />
            <ui:SliderInt picking-mode="Ignore" label="间距抖动" value="0" high-value="100" name="MinSpacingJitter" style="flex-shrink: 1; flex-grow: 1; max-height: 20px; min-height: 20px;" />
            <uie:IntegerField label="笔触种子" name="StrokeSeed" />
            <uie:IntegerField label="最大候选" name="MaxPoints" />
            <ui:Foldout text="簇集参数" name="ClusterSettings">
                <uie:IntegerField label="簇数量" name="ClusterCount" />
                <uie:IntegerField label="每簇数量" name="ChildPerCluster" />
                <ui:SliderInt picking-mode="Ignore" label="簇半径" value="10" high-value="100" name="ClusterRadius" />
                <ui:SliderInt picking-mode="Ignore" label="子点抖动" value="0" high-value="100" name="ChildJitter" />
            </ui:Foldout>
            <ui:Foldout text="条目混合与间距" name="Mixing">
                <ui:Toggle label="按权重混合条目" name="MixItemsWeighted" />
                <ui:Toggle label="限制每条目最大数量" name="LimitPerItem" />
                <ui:SliderInt picking-mode="Ignore" label="全局间距因子" value="0" high-value="100" name="GlobalSpacingFactor" />
                <ui:Toggle label="混合额外Profile" name="MixExtraProfiles" />
            </ui:Foldout>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
