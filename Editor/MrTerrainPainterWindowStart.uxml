<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/MrTerrPainterV1/Editor/MrTerrainPainterStyles.uss?fileID=7433441132597879392&amp;guid=1094a64c2bc4b654486d9ae7dcc8907c&amp;type=3#MrTerrainPainterStyles" />
    <ui:GroupBox style="flex-shrink: 1; flex-grow: 1; align-items: stretch; justify-content: space-between;">
        <ui:VisualElement style="flex-grow: 1; justify-content: center;">
            <ui:VisualElement class="mt-frame">
                <ui:Label text="MrTerrPainter" display-tooltip-when-elided="true" name="LOGO" style="flex-shrink: 1; flex-grow: 1; font-size: 47px; -unity-text-align: middle-center; -unity-font-style: bold; color: rgb(226, 131, 72); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;" />
            </ui:VisualElement>
            <ui:VisualElement class="mt-frame" style="flex-grow: 1; display: none;">
                <ui:Foldout text="TerrainList" name="TerrainList" style="flex-grow: 1;" />
            </ui:VisualElement>
            <ui:VisualElement style="align-items: stretch; justify-content: space-between; height: 36px; flex-grow: 0; flex-direction: row; display: none;">
                <ui:Button text="ScanTerrains" display-tooltip-when-elided="true" name="ScanTerrains" class="mt-button" style="flex-grow: 0; flex-shrink: 1; width: 100px;" />
                <ui:Button text="AddSelectedTerrain" display-tooltip-when-elided="true" name="AddSelectedTerrain" class="mt-button" style="flex-grow: 1; flex-shrink: 1;" />
                <ui:Button text="Clear" display-tooltip-when-elided="true" name="ClearTerrainList" class="mt-buttonR" style="flex-grow: 0; flex-shrink: 1; width: 100px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:GroupBox>
</ui:UXML>
