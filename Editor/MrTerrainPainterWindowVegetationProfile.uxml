<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/MrTerrPainterV1/Editor/MrTerrainPainterStyles.uss?fileID=7433441132597879392&amp;guid=1094a64c2bc4b654486d9ae7dcc8907c&amp;type=3#MrTerrainPainterStyles" />
    <ui:GroupBox picking-mode="Ignore" class="profile-row" style="flex-shrink: 1; flex-grow: 1; min-width: 400px;">
        <ui:VisualElement class="profile-row__top" style="flex-grow: 1;">
            <ui:Toggle name="Select" />
            <uie:ObjectField name="ProfileField" style="flex-shrink: 1; flex-grow: 1; min-height: 20px; max-height: 20px; height: 20px;" />
            <ui:Button text="X" display-tooltip-when-elided="true" name="DeleteProfileInline" class="mt-buttonR" style="flex-shrink: 1; flex-grow: 1; min-height: 20px; min-width: 20px; max-width: 20px; max-height: 20px; height: 20px; width: 20px;" />
        </ui:VisualElement>
        <ui:GroupBox name="Thumbs" class="profile-row__thumbs" style="background-color: rgba(0, 0, 0, 0);" />
    </ui:GroupBox>
</ui:UXML>
